# Copy these values into your hosting provider's environment settings.
# Never commit real credentials.
BOOKNGO_DB_HOST=127.0.0.1
BOOKNGO_DB_PORT=3306
BOOKNGO_DB_NAME=bookngo
BOOKNGO_DB_USER=root
BOOKNGO_DB_PASSWORD=

# Managed MySQL providers such as Aiven require TLS.
# BOOKNGO_DB_SSL=true
# BOOKNGO_DB_SSL_CA=C:\path\to\ca.pem
# BOOKNGO_DB_SSL_VERIFY=true

# Vercel uses MySQL sessions automatically. Enable on other hosts if needed.
# BOOKNGO_SESSION_DRIVER=mysql
